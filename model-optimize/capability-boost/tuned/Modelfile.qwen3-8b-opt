# qwen3:8b 优化版 Modelfile
# 基于 qwen3-optimize/scripts/02-Modelfile-qwen3-8b 精修
# 目标：i5-12400 6C12T / 32GB / CPU 推理

FROM qwen3:8b

# 线程数（三档建议）
# i5-12400 = 6 个 P 核（支持超线程，逻辑 12 线程）
# Ollama 默认线程数可能非最优，实测三档：
#
# 档位 1: num_thread 6  —— 严格等于物理核数
#   优点：无超线程上下文切换开销，单核利用率最高
#   适用：单次推理、低并发场景
#   预期 tok/s：~5.5-6.5（相对默认提升 ~10-20%）
#
# 档位 2: num_thread 8  —— 物理核 + 2 超线程（推荐）
#   优点：平衡计算密度与并行度，矩阵乘法可充分利用 8 线程
#   适用：通用场景，Ollama 默认可能落在 6-10 之间
#   预期 tok/s：~6.0-7.5（相对默认提升 ~20-40%）
#
# 档位 3: num_thread 10 —— 物理核 + 4 超线程
#   优点：最大化并行度，长上下文生成时吞吐更高
#   代价：超线程争抢导致单核效率略降，TTFT 可能略增
#   适用：长文本生成、批处理
#   预期 tok/s：~6.5-8.0（相对默认提升 ~30-50%，但 TTFT 可能 +5-10%）
#
# 选择依据：i5-12400 的 6P 核在纯 CPU 推理时，8 线程为性价比甜点；
# 若主要跑短对话选 6，跑长生成选 10，通用选 8。
# 此处设 8 作为默认值，可在运行时通过 API options 覆盖。

PARAMETER num_thread 8

# 上下文长度
# 8192 是当前 8B 模型在 32GB 内存下的稳定档位
# 4096 太小（长对话频繁截断），16384 会导致 KV cache 暴涨、推理变慢
PARAMETER num_ctx 8192

# 采样参数
# 低温度：代码/逻辑任务需要确定性输出，0.3 是代码与创意的分界线
# 通用对话可用 0.5-0.7，代码/分析用 0.1-0.3
PARAMETER temperature 0.3

# top_k 20：限制候选词范围，提升输出质量（减少低质量 token 干扰）
PARAMETER top_k 20

# top_p 0.8：配合 top_k 使用，进一步约束尾部概率
PARAMETER top_p 0.8

# 停止序列
# 防止模型在回答结束后输出多余内容
# Qwen3 chatml 模板的标准结束标记
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"
PARAMETER stop "<|header_end|>"