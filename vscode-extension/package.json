{
  "name": "feihong-code-vscode",
  "displayName": "飞虹 Code (Feihong Code)",
  "description": "飞虹 Code VSCode 插件 — AI 编程智能体，实时代码补全 + Agent 聊天侧边栏 + 多文件变更审批",
  "version": "1.0.0",
  "publisher": "feihong-zhi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "autocomplete",
    "agent",
    "feihong",
    "飞虹",
    "copilot",
    "swe-agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "feihong-code.chat",
        "title": "飞虹 Code: 打开 AI 聊天",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "feihong-code.explain",
        "title": "飞虹 Code: 解释选中代码"
      },
      {
        "command": "feihong-code.refactor",
        "title": "飞虹 Code: 重构选中代码"
      },
      {
        "command": "feihong-code.generateTests",
        "title": "飞虹 Code: 生成单元测试"
      },
      {
        "command": "feihong-code.fixErrors",
        "title": "飞虹 Code: 修复诊断错误"
      },
      {
        "command": "feihong-code.toggleInlineCompletions",
        "title": "飞虹 Code: 开关内联补全"
      },
      {
        "command": "feihong-code.setBackendUrl",
        "title": "飞虹 Code: 设置后端服务地址"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "feihong-code",
          "title": "飞虹 Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "feihong-code": [
        {
          "type": "webview",
          "id": "feihong-code.chat",
          "name": "AI 助手"
        },
        {
          "id": "feihong-code.changes",
          "name": "变更审批"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "feihong-code.explain",
          "when": "editorHasSelection",
          "group": "feihong-code@1"
        },
        {
          "command": "feihong-code.refactor",
          "when": "editorHasSelection",
          "group": "feihong-code@2"
        },
        {
          "command": "feihong-code.generateTests",
          "when": "editorHasSelection",
          "group": "feihong-code@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "feihong-code.chat",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      },
      {
        "command": "feihong-code.toggleInlineCompletions",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "configuration": {
      "title": "飞虹 Code",
      "properties": {
        "feihong-code.backendUrl": {
          "type": "string",
          "default": "http://localhost:3717",
          "description": "飞虹 Code 后端服务地址"
        },
        "feihong-code.enableInlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "启用内联代码补全（ghost text）"
        },
        "feihong-code.completionMode": {
          "type": "string",
          "enum": ["quick", "full"],
          "default": "quick",
          "description": "补全模式：quick=短补全（快速），full=完整补全（多行）"
        },
        "feihong-code.completionDebounceMs": {
          "type": "number",
          "default": 300,
          "description": "补全请求防抖延迟（毫秒）"
        },
        "feihong-code.apiKey": {
          "type": "string",
          "default": "",
          "description": "API 密钥（如后端启用了鉴权）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {},
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wch887292/feihong-code.git"
  },
  "homepage": "https://www.klai.top",
  "license": "MIT"
}
