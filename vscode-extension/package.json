{
  "name": "feihong-code-vscode",
  "displayName": "飞虹 Code（Muse Code 复刻）",
  "description": "VS Code 薄壳扩展：连接本地 fhcode serve，提供行内补全与侧边栏对话。企业可在自己机房里跑的私有版 Cursor。",
  "version": "1.0.0",
  "publisher": "feihong-code",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Chat"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "completion",
    "private",
    "offline"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fhcode.connect",
        "title": "飞虹 Code: 连接本地服务"
      },
      {
        "command": "fhcode.openChat",
        "title": "飞虹 Code: 打开对话面板"
      },
      {
        "command": "fhcode.submitSelection",
        "title": "飞虹 Code: 把选中代码作为任务发给 Agent"
      },
      {
        "command": "fhcode.toggleInlineCompletion",
        "title": "飞虹 Code: 开关行内补全"
      }
    ],
    "configuration": {
      "title": "飞虹 Code",
      "properties": {
        "fhcode.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "fhcode serve 的地址（Electron 版默认 8081，CLI serve 默认 8080）"
        },
        "fhcode.token": {
          "type": "string",
          "default": "",
          "description": "若已在服务端配置固定令牌(FH_WEB_TOKEN)，填这里；留空则自动用手机号登录换取临时令牌"
        },
        "fhcode.phone": {
          "type": "string",
          "default": "vscode-local",
          "description": "自动登录使用的手机号（仅本地标识，无短信验证）"
        },
        "fhcode.modelId": {
          "type": "string",
          "default": "",
          "description": "提交任务时指定的模型 ID，留空用服务端默认模型"
        },
        "fhcode.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "是否启用编辑器内行内补全"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fhcode",
          "title": "飞虹 Code",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "fhcode": [
        {
          "type": "webview",
          "id": "fhcode.chat",
          "name": "对话"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo '纯 JS 扩展，无需编译'",
    "package": "vsce package --no-dependencies"
  },
  "author": "吴赐虹 (晋江市飞虹智科技企业管理有限公司)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wch887292/feihong-code.git"
  }
}
