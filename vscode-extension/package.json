{
  "name": "fhcode-vscode",
  "displayName": "fhcode — 飞虹 Code",
  "description": "调起 fhcode 终端 AI 编程智能体：运行任务、查看会话 diff（最小可用壳）",
  "version": "0.5.0",
  "publisher": "feihong",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:fhcode.run",
    "onCommand:fhcode.diff",
    "onCommand:fhcode.output",
    "onCommand:fhcode.review",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fhcode.run",
        "title": "fhcode: 运行任务（附带选区上下文）",
        "category": "fhcode"
      },
      {
        "command": "fhcode.review",
        "title": "fhcode: 内联评审当前文件",
        "category": "fhcode"
      },
      {
        "command": "fhcode.diff",
        "title": "fhcode: 就地查看工作区 diff（HEAD ↔ 工作区）",
        "category": "fhcode"
      },
      {
        "command": "fhcode.output",
        "title": "fhcode: 查看最近任务输出",
        "category": "fhcode"
      }
    ],
    "configuration": {
      "title": "fhcode",
      "properties": {
        "fhcode.binaryPath": {
          "type": "string",
          "default": "fhcode",
          "description": "fhcode 可执行文件路径（默认取 PATH 中的 fhcode）"
        },
        "fhcode.offline": {
          "type": "boolean",
          "default": false,
          "description": "以离线模式（mock）运行，便于无模型环境验证"
        },
        "fhcode.reviewOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存文件后自动运行 fhcode review 内联评审"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
