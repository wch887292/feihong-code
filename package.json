{
  "name": "feihong-code",
  "version": "7.2.0",
  "description": "fhcode（飞虹 Code）— 终端 AI 编程智能体，对标 Muse Code / Cursor CLI：多模型路由（DeepSeek/通义/Ollama/OpenAI）、企业级 RBAC 审计、全自动 SWE Agent、支持离线私有化",
  "bin": {
    "fhcode": "dist/cli/index.js"
  },
  "main": "electron/main.js",
  "files": [
    "dist",
    "templates/skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "AGENT-GUIDE.md",
    "tool-schema.json",
    "docs",
    ".github"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-web.cjs",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "verify:m4": "node scripts/verify-m4.mjs",
    "verify:m6": "node scripts/verify-m6.mjs",
    "verify:m7": "node scripts/verify-m7.mjs",
    "verify:m8": "node scripts/verify-m8.mjs",
    "verify:m9": "node scripts/verify-m9.mjs",
    "eval": "node scripts/eval.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm run verify:m4 && npm run verify:m6 && npm run verify:m7 && npm run verify:m8 && npm run verify:m9",
    "prepublishOnly": "npm run build",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:dist": "npm run build && electron-builder --win --x64 --publish never",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-agent",
    "coding",
    "cli",
    "llm",
    "large-language-model",
    "muse-code",
    "autonomous-agent",
    "swe-agent",
    "software-engineering",
    "deepseek",
    "ollama",
    "openai",
    "typescript",
    "rbac",
    "enterprise",
    "multi-tenant",
    "code-generation",
    "test-generation",
    "terminal",
    "developer-tools",
    "productivity",
    "agentic",
    "vibe-coding",
    "code-review",
    "refactor",
    "automation",
    "mcp",
    "tool-use",
    "self-evolving",
    "self-healing",
    "swebench",
    "offline-ai",
    "multi-model",
    "production-ready",
    "enterprise-grade",
    "code-assistant",
    "agentic-ai",
    "prompt-template"
  ],
  "author": "吴赐虹 (晋江市飞虹智科技企业管理有限公司) <wch887292@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wch887292/feihong-code.git"
  },
  "homepage": "https://www.klai.top",
  "bugs": {
    "url": "https://github.com/wch887292/feihong-code/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "company",
    "url": "https://www.klai.top"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^7.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-language-server": "^5.3.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "express": "^4.21.2",
    "monaco-editor": "^0.56.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "build": {
    "appId": "com.feihong.code",
    "productName": "飞虹 Code",
    "copyright": "Copyright © 2026 晋江市飞虹智科技企业管理有限公司",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.ts",
      "!**/*.map",
      "!tests/**",
      "!docs/**",
      "!scripts/**",
      "!src/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "飞虹 Code"
    },
    "portable": {
      "artifactName": "飞虹Code-Portable-${version}.exe"
    }
  }
}
