{
  "name": "feihong-code",
  "version": "0.2.1",
  "description": "飞虹 Code — 终端 AI 编程智能体（对标 Muse Code），支持多模型路由、企业级 RBAC/审计、全自动 SWE Agent",
  "bin": {
    "fhcode": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "AGENT-GUIDE.md",
    "tool-schema.json",
    "docs",
    ".github"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-web.cjs",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "verify:m4": "node scripts/verify-m4.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm run verify:m4",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-agent",
    "coding",
    "cli",
    "llm",
    "large-language-model",
    "muse-code",
    "autonomous-agent",
    "swe-agent",
    "software-engineering",
    "deepseek",
    "ollama",
    "openai",
    "typescript",
    "rbac",
    "enterprise",
    "multi-tenant",
    "code-generation",
    "test-generation"
  ],
  "author": "吴赐虹 <wch887292@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wch887292/feihong-code.git"
  },
  "homepage": "https://github.com/wch887292/feihong-code#readme",
  "bugs": {
    "url": "https://github.com/wch887292/feihong-code/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wch887292"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^4.4.3"
  }
}
